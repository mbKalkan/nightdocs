{
  "name": "nightdocs",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.0.1",
  "publisher": "mbkalkan",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mbKalkan/nightdocs.git"
  },
  "bugs": {
    "url": "https://github.com/mbKalkan/nightdocs/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "docx",
    "word",
    "viewer",
    "office",
    "dark"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "nightdocs.viewer",
        "displayName": "%customEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.docx"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "nightdocs.openInOffice",
        "title": "%command.openInOffice%",
        "category": "%category%",
        "icon": "$(link-external)"
      },
      {
        "command": "nightdocs.zoomIn",
        "title": "%command.zoomIn%",
        "category": "%category%"
      },
      {
        "command": "nightdocs.zoomOut",
        "title": "%command.zoomOut%",
        "category": "%category%"
      },
      {
        "command": "nightdocs.resetZoom",
        "title": "%command.resetZoom%",
        "category": "%category%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nightdocs.openInOffice",
          "when": "activeCustomEditorId == nightdocs.viewer"
        },
        {
          "command": "nightdocs.zoomIn",
          "when": "activeCustomEditorId == nightdocs.viewer"
        },
        {
          "command": "nightdocs.zoomOut",
          "when": "activeCustomEditorId == nightdocs.viewer"
        },
        {
          "command": "nightdocs.resetZoom",
          "when": "activeCustomEditorId == nightdocs.viewer"
        }
      ]
    },
    "keybindings": [
      {
        "command": "nightdocs.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeCustomEditorId == nightdocs.viewer"
      },
      {
        "command": "nightdocs.zoomIn",
        "key": "ctrl+numpad_add",
        "mac": "cmd+numpad_add",
        "when": "activeCustomEditorId == nightdocs.viewer"
      },
      {
        "command": "nightdocs.zoomIn",
        "key": "ctrl+shift+=",
        "mac": "cmd+shift+=",
        "when": "activeCustomEditorId == nightdocs.viewer"
      },
      {
        "command": "nightdocs.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeCustomEditorId == nightdocs.viewer"
      },
      {
        "command": "nightdocs.zoomOut",
        "key": "ctrl+numpad_subtract",
        "mac": "cmd+numpad_subtract",
        "when": "activeCustomEditorId == nightdocs.viewer"
      },
      {
        "command": "nightdocs.resetZoom",
        "key": "ctrl+numpad0",
        "mac": "cmd+numpad0",
        "when": "activeCustomEditorId == nightdocs.viewer"
      }
    ]
  },
  "files": [
    "dist/**",
    "l10n/**",
    "package.nls*.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.extension.json && tsc -p tsconfig.webview.json && tsc -p tsconfig.json",
    "lint": "eslint src scripts test",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"scripts/**/*.mjs\" \"test/**/*.ts\" \"*.{json,mjs,ts}\" \".github/**/*.yml\" \".vscode/*.json\" \"l10n/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"scripts/**/*.mjs\" \"test/**/*.ts\" \"*.{json,mjs,ts}\" \".github/**/*.yml\" \".vscode/*.json\" \"l10n/*.json\"",
    "test": "vitest run --passWithNoTests",
    "test:visual": "node scripts/build.mjs && playwright test",
    "test:smoke": "node scripts/build.mjs && node scripts/smoke.mjs",
    "fixtures": "node scripts/gen-fixtures.mjs",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "node scripts/build.mjs --production"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "docx": "^9.10.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "docx-preview": "^0.4.1",
    "jszip": "^3.10.2"
  }
}
