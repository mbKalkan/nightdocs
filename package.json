{
  "name": "nightdocs",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.3.0",
  "publisher": "MBKDevStudio",
  "icon": "assets/icon.png",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mbKalkan/nightdocs.git"
  },
  "homepage": "https://github.com/mbKalkan/nightdocs#readme",
  "bugs": {
    "url": "https://github.com/mbKalkan/nightdocs/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "docx",
    "xlsx",
    "pptx",
    "word",
    "excel",
    "powerpoint",
    "office",
    "spreadsheet",
    "presentation",
    "slides",
    "docx diff",
    "viewer",
    "preview",
    "excel diff",
    "office viewer",
    "word viewer",
    "excel viewer",
    "powerpoint viewer",
    "docx viewer",
    "xlsx viewer",
    "pptx viewer",
    "dark mode",
    "diff",
    "compare",
    "git diff",
    "markdown",
    "markdown viewer",
    "markdown diff",
    "markdown preview",
    "frontmatter"
  ],
  "pricing": "Free",
  "galleryBanner": {
    "color": "#1e2033",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "browser": "./dist/extension.web.js",
  "l10n": "./l10n",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "languages": [
      {
        "id": "docx",
        "aliases": [
          "Word"
        ],
        "extensions": [
          ".docx",
          ".docm",
          ".dotx",
          ".dotm"
        ]
      },
      {
        "id": "xlsx",
        "aliases": [
          "Excel"
        ],
        "extensions": [
          ".xlsx",
          ".xlsm",
          ".xltx",
          ".xltm"
        ]
      },
      {
        "id": "pptx",
        "aliases": [
          "PowerPoint"
        ],
        "extensions": [
          ".pptx",
          ".pptm",
          ".ppsx",
          ".ppsm",
          ".potx",
          ".potm"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "nightdocs.viewer",
        "displayName": "%customEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.docx"
          },
          {
            "filenamePattern": "*.docm"
          },
          {
            "filenamePattern": "*.dotx"
          },
          {
            "filenamePattern": "*.dotm"
          },
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.xlsm"
          },
          {
            "filenamePattern": "*.xltx"
          },
          {
            "filenamePattern": "*.xltm"
          },
          {
            "filenamePattern": "*.pptx"
          },
          {
            "filenamePattern": "*.pptm"
          },
          {
            "filenamePattern": "*.ppsx"
          },
          {
            "filenamePattern": "*.ppsm"
          },
          {
            "filenamePattern": "*.potx"
          },
          {
            "filenamePattern": "*.potm"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "nightdocs.markdown",
        "displayName": "%customEditor.markdownDisplayName%",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          },
          {
            "filenamePattern": "*.mdc"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "nightdocs.openMarkdown",
        "title": "%command.openMarkdown%",
        "category": "%category%",
        "icon": "$(book)"
      },
      {
        "command": "nightdocs.openInOffice",
        "title": "%command.openInOffice%",
        "category": "%category%",
        "icon": "$(link-external)"
      },
      {
        "command": "nightdocs.zoomIn",
        "title": "%command.zoomIn%",
        "category": "%category%"
      },
      {
        "command": "nightdocs.zoomOut",
        "title": "%command.zoomOut%",
        "category": "%category%"
      },
      {
        "command": "nightdocs.resetZoom",
        "title": "%command.resetZoom%",
        "category": "%category%"
      },
      {
        "command": "nightdocs.nextSheet",
        "title": "%command.nextSheet%",
        "category": "%category%"
      },
      {
        "command": "nightdocs.previousSheet",
        "title": "%command.previousSheet%",
        "category": "%category%"
      },
      {
        "command": "nightdocs.goToSheet",
        "title": "%command.goToSheet%",
        "category": "%category%"
      },
      {
        "command": "nightdocs.goToSlide",
        "title": "%command.goToSlide%",
        "category": "%category%"
      },
      {
        "command": "nightdocs.goToHeading",
        "title": "%command.goToHeading%",
        "category": "%category%"
      },
      {
        "command": "nightdocs.find",
        "title": "%command.find%",
        "category": "%category%"
      },
      {
        "command": "nightdocs.toggleNavigation",
        "title": "%command.toggleNavigation%",
        "category": "%category%"
      },
      {
        "command": "nightdocs.copyAsMarkdown",
        "title": "%command.copyAsMarkdown%",
        "category": "%category%"
      },
      {
        "command": "nightdocs.copyReference",
        "title": "%command.copyReference%",
        "category": "%category%"
      },
      {
        "command": "nightdocs.copyReferenceWithText",
        "title": "%command.copyReferenceWithText%",
        "category": "%category%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nightdocs.openMarkdown",
          "when": "(resourceLangId == markdown || resourceExtname == .mdc) && activeCustomEditorId != nightdocs.markdown"
        },
        {
          "command": "nightdocs.openInOffice",
          "when": "activeCustomEditorId =~ /^nightdocs\\./"
        },
        {
          "command": "nightdocs.zoomIn",
          "when": "activeCustomEditorId =~ /^nightdocs\\./"
        },
        {
          "command": "nightdocs.zoomOut",
          "when": "activeCustomEditorId =~ /^nightdocs\\./"
        },
        {
          "command": "nightdocs.resetZoom",
          "when": "activeCustomEditorId =~ /^nightdocs\\./"
        },
        {
          "command": "nightdocs.nextSheet",
          "when": "activeCustomEditorId =~ /^nightdocs\\./"
        },
        {
          "command": "nightdocs.previousSheet",
          "when": "activeCustomEditorId =~ /^nightdocs\\./"
        },
        {
          "command": "nightdocs.goToSheet",
          "when": "activeCustomEditorId =~ /^nightdocs\\./ && nightdocs.activeFormat == xlsx"
        },
        {
          "command": "nightdocs.goToSlide",
          "when": "activeCustomEditorId =~ /^nightdocs\\./ && nightdocs.activeFormat == pptx"
        },
        {
          "command": "nightdocs.goToHeading",
          "when": "activeCustomEditorId =~ /^nightdocs\\./ && nightdocs.activeFormat =~ /^(docx|md)$/"
        },
        {
          "command": "nightdocs.find",
          "when": "activeCustomEditorId =~ /^nightdocs\\./ && nightdocs.activeFormat == xlsx"
        },
        {
          "command": "nightdocs.toggleNavigation",
          "when": "activeCustomEditorId =~ /^nightdocs\\./"
        },
        {
          "command": "nightdocs.copyAsMarkdown",
          "when": "activeCustomEditorId =~ /^nightdocs\\./ && nightdocs.activeFormat == xlsx"
        },
        {
          "command": "nightdocs.copyReference",
          "when": "activeCustomEditorId =~ /^nightdocs\\./"
        },
        {
          "command": "nightdocs.copyReferenceWithText",
          "when": "activeCustomEditorId =~ /^nightdocs\\./"
        }
      ],
      "webview/context": [
        {
          "command": "nightdocs.copyReference",
          "when": "(webviewId == 'nightdocs.viewer' || webviewId == 'nightdocs.markdown')",
          "group": "9_cutcopypaste@1"
        },
        {
          "command": "nightdocs.copyReferenceWithText",
          "when": "(webviewId == 'nightdocs.viewer' || webviewId == 'nightdocs.markdown')",
          "group": "9_cutcopypaste@2"
        },
        {
          "command": "nightdocs.copyAsMarkdown",
          "when": "(webviewId == 'nightdocs.viewer' || webviewId == 'nightdocs.markdown') && nightdocs.activeFormat == xlsx",
          "group": "9_cutcopypaste@3"
        }
      ],
      "editor/title": [
        {
          "command": "nightdocs.openMarkdown",
          "when": "(resourceLangId == markdown || resourceExtname == .mdc) && (activeEditor == workbench.editors.files.textFileEditor || activeEditor == workbench.editors.textDiffEditor)",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "nightdocs.openMarkdown",
          "when": "(resourceLangId == markdown || resourceExtname == .mdc) && !explorerResourceIsFolder",
          "group": "navigation@20"
        }
      ]
    },
    "keybindings": [
      {
        "command": "nightdocs.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeCustomEditorId =~ /^nightdocs\\./"
      },
      {
        "command": "nightdocs.zoomIn",
        "key": "ctrl+numpad_add",
        "mac": "cmd+numpad_add",
        "when": "activeCustomEditorId =~ /^nightdocs\\./"
      },
      {
        "command": "nightdocs.zoomIn",
        "key": "ctrl+shift+=",
        "mac": "cmd+shift+=",
        "when": "activeCustomEditorId =~ /^nightdocs\\./"
      },
      {
        "command": "nightdocs.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeCustomEditorId =~ /^nightdocs\\./"
      },
      {
        "command": "nightdocs.zoomOut",
        "key": "ctrl+numpad_subtract",
        "mac": "cmd+numpad_subtract",
        "when": "activeCustomEditorId =~ /^nightdocs\\./"
      },
      {
        "command": "nightdocs.resetZoom",
        "key": "ctrl+numpad0",
        "mac": "cmd+numpad0",
        "when": "activeCustomEditorId =~ /^nightdocs\\./"
      },
      {
        "command": "nightdocs.nextSheet",
        "key": "ctrl+alt+pagedown",
        "mac": "cmd+alt+pagedown",
        "when": "activeCustomEditorId =~ /^nightdocs\\./"
      },
      {
        "command": "nightdocs.previousSheet",
        "key": "ctrl+alt+pageup",
        "mac": "cmd+alt+pageup",
        "when": "activeCustomEditorId =~ /^nightdocs\\./"
      },
      {
        "command": "nightdocs.goToSheet",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeCustomEditorId =~ /^nightdocs\\./ && nightdocs.activeFormat == xlsx"
      },
      {
        "command": "nightdocs.goToSlide",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeCustomEditorId =~ /^nightdocs\\./ && nightdocs.activeFormat == pptx"
      },
      {
        "command": "nightdocs.goToHeading",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeCustomEditorId =~ /^nightdocs\\./ && nightdocs.activeFormat =~ /^(docx|md)$/"
      },
      {
        "command": "nightdocs.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId =~ /^nightdocs\\./ && nightdocs.activeFormat == xlsx"
      }
    ],
    "configuration": {
      "title": "Nightdocs",
      "properties": {
        "nightdocs.markdown.compareRendered": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.markdown.compareRendered%"
        },
        "nightdocs.markdown.showOnlineContent": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.markdown.showOnlineContent%"
        }
      }
    }
  },
  "files": [
    "dist/**",
    "l10n/**",
    "package.nls*.json",
    "assets/icon.png",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.extension.json && tsc -p tsconfig.webview.json && tsc -p tsconfig.json",
    "lint": "eslint src scripts test",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"scripts/**/*.mjs\" \"test/**/*.ts\" \"*.{json,mjs,ts}\" \".github/**/*.yml\" \".vscode/*.json\" \"l10n/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"scripts/**/*.mjs\" \"test/**/*.ts\" \"*.{json,mjs,ts}\" \".github/**/*.yml\" \".vscode/*.json\" \"l10n/*.json\"",
    "test": "vitest run --passWithNoTests",
    "test:visual": "node scripts/build.mjs && playwright test",
    "screenshots": "node scripts/build.mjs && node scripts/screenshots.mjs",
    "corpus": "node scripts/build.mjs && node scripts/corpus.mjs",
    "demo": "node scripts/build.mjs && node scripts/demo.mjs",
    "icon": "node scripts/render-icon.mjs",
    "test:smoke": "node scripts/build.mjs && node scripts/smoke.mjs",
    "fixtures": "node scripts/gen-fixtures.mjs",
    "fixtures:large": "node scripts/gen-fixtures.mjs --large",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "node scripts/build.mjs --production",
    "test:web": "node scripts/build.mjs && node scripts/smoke-web.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^4.0.0",
    "docx": "^9.10.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.3.0",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "js-yaml": "^5.4.3",
    "jszip": "^3.10.2",
    "markdown-it": "^15.0.2",
    "markdown-it-footnote": "^4.0.0",
    "ssf": "^0.11.2"
  }
}
